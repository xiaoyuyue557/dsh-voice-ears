{
  "name": "dsh-voice-ears",
  "version": "0.1.0",
  "description": "给 DSH 里的 agent 装一双本地耳朵：把别人发来的语音（含 QQ 的 SILK 语音条）转成文字，并且在没听清的时候敢于说没听清。全离线、不上传，默认 whisper medium，不需要 torch。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "asr",
    "stt",
    "voice",
    "whisper",
    "faster-whisper",
    "silk",
    "qq",
    "wechat",
    "bot",
    "ears"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runner": "./src/runner.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "python/*.py",
    "python/requirements.txt",
    "locale/*.json",
    "icon.svg",
    "test/smoke.mjs",
    "test/edge.mjs",
    "test/fixtures/*",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyuyue557/dsh-voice-ears.git"
  },
  "homepage": "https://github.com/xiaoyuyue557/dsh-voice-ears#readme",
  "bugs": {
    "url": "https://github.com/xiaoyuyue557/dsh-voice-ears/issues"
  },
  "author": "xiaoyuyue557 <plmpl002@163.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "silk-wasm": "^3.7.1"
  }
}
